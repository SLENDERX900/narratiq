# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Market & News Data
FINNHUB_API_KEY=your-finnhub-key
TWELVE_DATA_API_KEY=your-twelvedata-key
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret

# Tiingo — free, 500 req/day, 30yr historical data + news
# Register at: https://www.tiingo.com/account/api/token
TIINGO_API_KEY=your-tiingo-key

# FRED — free, 120 req/min, macro economic data
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-key

# Social Sentiment
# Marketaux: free 100 req/day — https://app.marketaux.com/register
MARKETAUX_API_KEY=your-marketaux-key

# LLM Providers
CEREBRAS_API_KEY=your-cerebras-key
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
